# ============================================================
# Portfolio MB — Apache/LiteSpeed rules for SEOhost shared hosting
#
# Vite copies public/ into dist/ verbatim, so this file lands at the web
# root (public_html/) after SEOhost's DirectAdmin Git deploy pulls the
# `production` branch. See docs/DEPLOY-SEOHOST.md for the full setup.
#
# One document root serves THREE hosts (all pointed at the same
# public_html via DirectAdmin subdomain / domain-pointer config):
#   marcinbochenek.com        -> index.html (main portfolio, MPA)
#   gra.marcinbochenek.com    -> gra.html    (space game, indexed)
#   mb-ai.pl                  -> mb-ai.html  (+ /en/, /ua/ variants)
#
# Routing rules below are translated 1:1 from deploy/Caddyfile — read
# that file for the "why" behind each route; comments here focus on the
# Apache-specific mechanics.
#
# Almost everything under /en/, /ua/, /artykuly/, /en/articles/,
# /ua/statti/ is a REAL static file/directory already present in dist/
# (public/ ships literal index.html files for every locale home and
# every journal article — see scripts/generate-articles.mjs). Apache's
# own DirectoryIndex resolves those natively, so — unlike the Caddyfile,
# which needs explicit try_files/file_server blocks — most locale/journal
# routes need NO RewriteRule at all here. A missing slug/article 404s on
# its own because there's simply no file to match; there is no SPA
# fallback to guard against.
#
# Only genuine "same file, different URL" cases (archive pages under a
# locale prefix, /v4 shortcut, host-based dispatch to gra.html/mb-ai.html)
# and true redirects (www -> apex, /uk -> /ua) need explicit rules.
# ============================================================

RewriteEngine On
Options -MultiViews
Options -Indexes
Options +FollowSymLinks

# --- Security: force HTTPS -------------------------------------------------
# SEOhost/LiteSpeed may terminate TLS at an edge proxy and forward plain
# HTTP internally, so %{HTTPS} alone can false-negative on an already-secure
# request; the X-Forwarded-Proto guard prevents a redirect loop in that case.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# --- SEO: www -> apex, preserving path (marcinbochenek.com + mb-ai.pl) -----
# Non-GET/HEAD requests get 308 instead of 301: a 301 may be replayed as a
# GET by some clients, silently dropping a POST body (e.g. a form submit).
RewriteCond %{HTTP_HOST} ^www\.(marcinbochenek\.com|mb-ai\.pl)$ [NC]
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
RewriteRule ^ https://%1%{REQUEST_URI} [R=308,L]

RewriteCond %{HTTP_HOST} ^www\.(marcinbochenek\.com|mb-ai\.pl)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ============================================================
# gra.marcinbochenek.com — space game, single entry point
# ============================================================
# Root ("/") first: the shared docroot's "/" resolves to a real directory
# (DOCUMENT_ROOT itself, -d true) whose DirectoryIndex is the MAIN
# portfolio's index.html — an !-f/!-d guarded catch-all alone would never
# fire for "/", so gra.marcinbochenek.com's homepage would silently show
# the wrong site without this explicit rule.
RewriteCond %{HTTP_HOST} ^gra\.marcinbochenek\.com$ [NC]
RewriteRule ^$ /gra.html [L]

# Real files (assets/*, fonts/*, favicon.svg, ...) are shared with the main
# dist/ root and still resolve directly; only unmatched paths fall through
# to gra.html. This mirrors `try_files {path} /gra.html` in the Caddyfile.
RewriteCond %{HTTP_HOST} ^gra\.marcinbochenek\.com$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /gra.html [L]

# ============================================================
# mb-ai.pl — AI landing page + /en/ + /ua/ variants
# ============================================================
# Legacy /uk -> /ua redirect (ported from vite.config.ts's localeHtmlPlugin
# dev middleware). Must run before the locale/fallback rewrites below.
RewriteCond %{HTTP_HOST} ^mb-ai\.pl$ [NC]
RewriteRule ^uk/?$ /ua/ [R=301,L]

RewriteCond %{HTTP_HOST} ^mb-ai\.pl$ [NC]
RewriteRule ^mb-ai-uk\.html$ /mb-ai-ua.html [R=301,L]

# /en, /en/ -> mb-ai-en.html; /ua, /ua/ -> mb-ai-ua.html (URL stays, internal
# rewrite — same as the Caddyfile's `rewrite @mbai_en /mb-ai-en.html`).
# Deliberately NOT guarded with !-f/!-d: the shared docroot also has a
# REAL /en/index.html and /ua/index.html (the main portfolio's locale
# homepages) — on mb-ai.pl those must be shadowed by mb-ai-en.html /
# mb-ai-ua.html, not served as-is, so this has to fire unconditionally
# for this host, same as the Caddyfile's unconditional `rewrite`.
RewriteCond %{HTTP_HOST} ^mb-ai\.pl$ [NC]
RewriteRule ^en/?$ /mb-ai-en.html [L]

RewriteCond %{HTTP_HOST} ^mb-ai\.pl$ [NC]
RewriteRule ^ua/?$ /mb-ai-ua.html [L]

# Root ("/") needs its own rule: the shared docroot's "/" resolves to a real
# directory (DOCUMENT_ROOT itself, -d true) whose DirectoryIndex is the MAIN
# portfolio's index.html — without this, the generic !-f/!-d fallback below
# would never fire for "/" and mb-ai.pl's homepage would silently show the
# wrong site.
RewriteCond %{HTTP_HOST} ^mb-ai\.pl$ [NC]
RewriteRule ^$ /mb-ai.html [L]

# Anything else unmatched (and not a real file/dir — shared assets like
# /assets/*, /fonts/*, /favicon.svg resolve directly) falls back to mb-ai.html.
RewriteCond %{HTTP_HOST} ^mb-ai\.pl$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /mb-ai.html [L]

# ============================================================
# marcinbochenek.com (and default host) — main portfolio
# ============================================================

# Legacy /uk -> /ua/, /uk/statti/* -> /ua/statti/* (ported 1:1 from
# vite.config.ts's localeHtmlPlugin dev middleware).
RewriteRule ^uk/?$ /ua/ [R=301,L]
RewriteRule ^uk/statti$ /ua/statti [R=301,L]
RewriteRule ^uk/statti/(.*)$ /ua/statti/$1 [R=301,L]

# Vanity shortcut: /v4, /v4/ -> v4.html (URL stays, internal rewrite).
RewriteRule ^v4/?$ /v4.html [L]

# Archive pages under a locale prefix: /(en|ua)/v[1-6].html serves the SAME
# root-level file without changing the browser URL (used by the language
# switcher on archive pages — see src/i18n/path.ts switchPath/archivePath).
# Only fires when there's no physical /en/v3.html etc. on disk (there
# isn't — only the locale index.html files live under en/ and ua/).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(en|ua)/(v[1-6]\.html)$ /$2 [L]

# ============================================================
# MIME types the host may be missing out of the box
# ============================================================
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType model/gltf-binary .glb
  AddType video/mp4 .mp4
  AddType video/webm .webm
</IfModule>

# ============================================================
# Caching
# ============================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType model/gltf-binary "access plus 1 day"
  ExpiresByType video/mp4 "access plus 1 day"
  ExpiresByType video/webm "access plus 1 day"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType application/wasm "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  # Only Vite's /assets/* are content-hashed, so only they are safe to cache
  # forever. Everything else (models, videos, posters, draco decoder) keeps
  # its filename between deploys and gets a day; fonts/images a year.
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/assets/" HASHED_ASSET
  </IfModule>
  <FilesMatch "\.(js|css|glb|mp4|webm|wasm|json)$">
    Header set Cache-Control "public, max-age=86400"
    Header set Cache-Control "public, max-age=31536000, immutable" env=HASHED_ASSET
  </FilesMatch>
  <FilesMatch "\.(woff2?|avif|webp|jpe?g|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML must always revalidate: a cached shell references the previous
  # build's /assets/* hashes, which are gone as soon as the next deploy
  # prunes them. max-age=0 + must-revalidate still allows a conditional
  # GET, so a repeat visit with no new deploy is a cheap 304.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ============================================================
# Security headers
# ============================================================
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

  # Content-Security-Policy — deliberately loose over broken:
  #   - script-src/style-src 'unsafe-inline': the app ships inline
  #     bootstrap/theme scripts and Tailwind-driven inline styles; no
  #     per-build hash list is maintained for this repo (unlike Mint's
  #     Astro build), so 'unsafe-inline' stays rather than risk silently
  #     blocking a script after every content edit.
  #   - font-src/style-src allow Google Fonts (self-hosted fonts also
  #     covered by 'self' via font-src).
  #   - connect-src covers Web3Forms (contact form) and Cal.com/Calendly
  #     (booking widgets), plus blob: for Web Workers / three.js.
  #   - frame-src covers Cal.com/Calendly iframes.
  #   - img-src/media-src allow data:/blob: (generated textures, canvases)
  #     alongside 'self'.
  #   - worker-src 'self' blob: for three.js / postprocessing workers.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' https://api.web3forms.com https://cal.com https://*.cal.com https://calendly.com https://*.calendly.com; frame-src 'self' https://cal.com https://*.cal.com https://calendly.com https://*.calendly.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com;"
</IfModule>

# ============================================================
# Block access to sensitive files
# ============================================================
<FilesMatch "(^\.env|\.htaccess|\.htpasswd|package(-lock)?\.json|\.git.*|README\.md)$">
  Require all denied
</FilesMatch>

# ============================================================
# 404
# ============================================================
ErrorDocument 404 /404.html
