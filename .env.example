# Publiczny adres kontaktowy widoczny w UI i fallbacku mailto
VITE_CONTACT_EMAIL=kontakt@marcinbochenek.com

# Publiczna domena portfolio (canonical / OG)
VITE_SITE_URL=https://marcinbochenek.com

# URL klasycznego portfolio — używane przez V4 (gra) przy cros-linkach
VITE_PORTFOLIO_URL=https://marcinbochenek.com

# Landing AI
VITE_MB_AI_URL=https://mb-ai.pl

# Gra kosmiczna (V4)
VITE_GAME_URL=https://gra.marcinbochenek.com

# Link do Calendly / Cal.com — primary CTA (wszystkie przyciski audytu)
# UWAGA: NIE ustawiaj https://cal.com/ ani placeholdera poniżej na produkcji —
# puste / root / YOUR-USER → CTA spadają na #kontakt (formularz), nie na homepage Cal.com.
VITE_CALENDLY_URL=https://cal.com/YOUR-USER/audyt

# Backend formularza bez serwera własnego
# Web3Forms: https://web3forms.com → skopiuj Access Key
# Zostaw puste lub usuń linię → fallback mailto (bez Web3Forms)
VITE_FORM_ENDPOINT=https://api.web3forms.com/submit
VITE_FORM_ACCESS_KEY=

# Alternatywa Formspree — tylko endpoint, bez access key:
# VITE_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Spline hero — opcjonalne (legacy v1)
# VITE_SPLINE_ORBIT_URL=https://prod.spline.design/xxxx/scene.splinecode
