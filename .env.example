# Publiczny adres kontaktowy widoczny w UI i fallbacku mailto
VITE_CONTACT_EMAIL=kontakt@bochen.studio

# Publiczna domena portfolio do canonical / sitemap
VITE_SITE_URL=https://bochen.studio

# Link do Calendly / Cal.com — primary CTA (wszystkie przyciski audytu)
VITE_CALENDLY_URL=https://cal.com/twoj-link/audyt

# Backend formularza bez serwera własnego
# Web3Forms: https://web3forms.com → skopiuj Access Key
VITE_FORM_ENDPOINT=https://api.web3forms.com/submit
VITE_FORM_ACCESS_KEY=your-web3forms-access-key

# Alternatywa Formspree — tylko endpoint, bez access key:
# VITE_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Spline hero — DOKŁADNE sceny po Publish na spline.design.
# Jak: otwórz plik community → „Remix" (kopia na Twoje konto) → Export → Publish →
#      skopiuj URL „prod.spline.design/.../scene.splinecode" i wklej poniżej.
# Gdy ustawione: na desktopie ładuje się PRAWDZIWA scena Spline (Three.js zostaje fallbackiem na mobile / brak WebGL).
# VITE_SPLINE_ORBIT_URL=https://prod.spline.design/xxxx/scene.splinecode      # „Rotating interactive hero section"
# VITE_SPLINE_GLASS_URL=https://prod.spline.design/xxxx/scene.splinecode      # „Glassmorph landing page"
# VITE_SPLINE_PARTICLES_URL=https://prod.spline.design/xxxx/scene.splinecode  # „Particles 🌑"
# VITE_SPLINE_RETRO_URL=https://prod.spline.design/xxxx/scene.splinecode      # „Retrofuturism - BG animation"
# VITE_SPLINE_TYPE_URL=https://prod.spline.design/xxxx/scene.splinecode       # „Distorting typography"
